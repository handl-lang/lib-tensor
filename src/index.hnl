--- The `ltensor` namespace record — `from "lib-tensor" import ltensor`
--- binds the whole surface at once, the same shape host-tensor's
--- `tensor` record has (its fields are arrows where host's are
--- qualified-name strings — both dispatch on call).
export ltensor := {
  zeros: __zeros,
  ones: __ones,
  from_list: __from_list,
  to_list: __to_list,
  shape: __shape,
  add: __add,
  add_backward: __add_backward,
  mul: __mul,
  mul_backward: __mul_backward,
  sub: __sub,
  sub_backward: __sub_backward,
  div: __div,
  div_backward: __div_backward,
  matmul: __matmul,
  matmul_backward: __matmul_backward,
  conv2d: __conv2d,
  conv2d_backward: __conv2d_backward,
  max_pool: __max_pool,
  max_pool_backward: __max_pool_backward,
  batch_norm: __batch_norm,
  reshape: __reshape,
  reshape_backward: __reshape_backward,
  transpose: __transpose,
  transpose_backward: __transpose_backward,
  concat: __concat,
  concat_backward: __concat_backward,
  batch_norm_backward: __batch_norm_backward,
  derive: __derive
}
