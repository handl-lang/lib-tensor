--- codec.hnl — the tensor wire representation and the boundary ops.
---
--- A tensor at the `Function` boundary is the tagged plain object
---   {"__tensor__": {"shape": [d, ...], "data": [x, ...], "dtype": "f64"}}
--- (host-tensor/src/ops/codec.rs `encode_tensor`; ADR-0083 §2.1): `shape` is
--- the extent per axis, `data` the flat row-major payload of length
--- `product(shape)`, `dtype` the element type (`"f64"` only).
---
--- lib-tensor operates *on the wire form*: inside an engine a
--- `.hnl` record literal stays a transparent `Obj` — the e-graph sees
--- `{__tensor__: {shape: …, data: …}}` structure, not an opaque leaf.
--- The two representations are now *observationally identical* in the
--- language: the tagged-object view (kernel `TaggedValue::object_view`)
--- projects an opaque `TaggedValue::Tensor` through its canonical wire
--- record, so `t.__tensor__.shape`/`t.__tensor__.data` and the record
--- pattern `{ "__tensor__": inner }` read a kernel `Tensor` exactly as
--- they read a `.hnl`-authored wire record. Every op in this package
--- therefore accepts BOTH representations at its tensor parameters —
--- `as_wire` normalizes either to the wire record — with **zero host
--- calls**: the old `_` arms that projected opaque inputs through the
--- literal-string callees `"tensor.shape"`/`"tensor.to_list"` are gone.
---
--- `shape`/`to_list`/`zeros`/`ones`/`from_list` mirror the host ops
--- 1:1: given wire records they need no host call at all, and given
--- opaque tensors the same reads project the wire view — the field
--- access a `.hnl` function could not perform before the view seam.

from "./internal/helpers.hnl" import { die, len, flat_num, product, replicate }

--- The canonical wire encoding of `(shape, data)`. (The parentheses are
--- load-bearing: a bare `~> {` parses as a block, not a record literal.)
export wire := (shape, ds) ~> ({
  "__tensor__": { "shape": shape, "data": ds, "dtype": "f64" }
})

--- Flat row-major payload for a wire record or opaque tensor — the
--- `.__tensor__` field projects on both representations (the opaque
--- case reads through the tagged-object view).
export wire_data := (t) ~> t.__tensor__.data

--- Extent-per-axis for either representation.
export wire_shape := (t) ~> t.__tensor__.shape

--- `as_wire(t)` — normalize a tensor argument: a wire record rebuilds
--- an identical record; an opaque `TaggedValue::Tensor` (a host op's
--- result) materializes the wire record of its projected shape and
--- data. A non-tensor errors at the `.__tensor__` field access (the
--- host impl's `TypeMismatch` — accept/reject parity, not message
--- parity).
export as_wire := (t) ~> wire(t.__tensor__.shape, t.__tensor__.data)

--- `infer_sh(xs)` — the `from_list` shape inference: a list contributes
--- `[len] ++ sub_sh` where `sub_sh` is the uniform sub_sh-shape of its elements;
--- a non-list leaf contributes `[]` (its numericness is checked later,
--- in `flat_num`). Ragged siblings are rejected via `die` — matching
--- the host impl's `ragged input` error on the accept/reject boundary.
infer_sh := (xs) ~> match xs {
  []: [0],
  [h, ...t]: do {
    sub_sh :: infer_sh(h)
    check :: match t {
      []: true,
      _: while { xs: t, ok: true } {
        (xs, ok) ~> match xs {
          []: { out: ok },
          [e, ...rest]: { state: { xs: rest, ok: ok && (infer_sh(e) == sub_sh) } }
        }
      }
    }
    if check {
      [len([h, ...t]), ...sub_sh]
    } else { die("tensor.from_list: ragged input") }
  },
  _: []
}

--- `tensor.from_list` — nested number arrays → wire tensor. A
--- non-array argument is an error (matching the host's TypeMismatch);
--- `[]` is the rank-1 empty tensor of shape `[0]`; `[[], []]` is
--- `[2, 0]`. Leaves are number-checked by `flat_num`.
export from_list := (xs) ~> match xs {
  []: wire([0], []),
  [_, ..._]: wire(infer_sh(xs), flat_num(xs)),
  _: die("tensor.from_list: expected nested number arrays")
}

drop1 := (xs) ~> match xs { []: [], [_, ...t]: t }

--- `nest(shape, ds)` — re-nest the flat row-major `ds` under `shape`,
--- returning `{v, rest}` where `{v, rest}`: `v` is the nested list form
--- and `rest` the unconsumed tail (the internal counterpart of
--- `to_list`; rank-0 `shape == []` projects the single scalar).
nest := (shape, ds) ~> match shape {
  []: { v: ds[0], rest: drop1(ds) },
  [d, ...rest]: while { i: 0, acc: [], rem: ds } {
    (i, acc, rem) ~> if i < d {
      do {
        r :: nest(rest, rem)
        { state: { i: i + 1, acc: [...acc, r.v], rem: r.rest } }
      }
    } else { { out: { v: acc, rest: rem } } }
  }
}

--- `tensor.to_list` — tensor → nested number arrays. Pure on both
--- representations: the wire view makes `t.__tensor__` project the
--- `{shape, data, dtype}` record whether `t` is a wire record or an
--- opaque `Tensor`.
export to_list := (t) ~> nest(t.__tensor__.shape, t.__tensor__.data).v

--- `tensor.shape` — the extent-per-axis list. Pure on both
--- representations for the same reason.
export shape := (t) ~> wire_shape(t)

--- `tensor.zeros` — a tensor of `shape` filled with `0`. The host fills
--- with `0.0`; the wire data here is integer `0`, which is `f64`
--- `0.0` the moment it crosses the `Function` boundary (`0 == 0.0`
--- holds elementwise under `to_list` comparison either way).
export zeros := (shp) ~> wire(shp, replicate(0, product(shp)))

--- `tensor.ones` — a tensor of `shape` filled with `1`.
export ones := (shp) ~> wire(shp, replicate(1, product(shp)))
