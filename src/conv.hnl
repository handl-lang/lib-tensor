--- conv.hnl — `conv2d` / `max_pool`: the NCHW spatial ops, spec-mirroring
--- host-tensor/src/ops/conv.rs `Conv2d` and `MaxPool`.
---
--- Optional trailing parameters are positional like the host ops: a
--- `null` (or a missing argument — the `...rest` list simply runs
--- short) selects the default. `stride`/`padding`/`kernel` decode the
--- int-or-`[h, w]`-pair convention through `pair_or`.

from "./internal/helpers.hnl" import { die, len, product, replicate, set, unravel }
from "./codec.hnl" import { wire, as_wire }

--- `opt(rest, i)` — the optional argument at `rest[i]`, `null` when
--- absent or `null` (the host's `has_opt_arg` convention).
opt_at := (rest, i) ~> if i < len(rest) { rest[i] } else { null }

--- `pair_or(v, default)` — the int-or-`[h, w]`-pair spatial parameter:
--- a two-element list unpacks, a single non-negative integer `n` means
--- `[n, n]`, `null` selects `default`; any other list length is an
--- error (the host's `opt_extent_pair`).
pair_or := (v, default) ~> match v {
  []: die("spatial parameter: int or [h, w] pair"),
  [a]: die("spatial parameter: int or [h, w] pair"),
  [a, b]: [a, b],
  [a, b, ...t]: die("spatial parameter: int or [h, w] pair"),
  _: if v == null { default } else { [v, v] }
}

--- `pos_int_or(v, default)` — `groups`: `null`/`absent` → `default`;
--- `0` is an error (the host's `opt_positive_int`).
pos_int_or := (v, default) ~> if v == null { default } else {
  if v == 0 { die("groups: must be a positive integer") } else { v }
}

--- `num_or(v, default)` — `eps`: `null`/`absent` → `default`; a
--- negative number is an error (the host's `opt_nonneg_float` —
--- non-finite values carry no `serde_json` representation anyway).
num_or := (v, default) ~> if v == null { default } else {
  if v < 0 { die("eps: expected a non-negative finite number") } else { v }
}

--- `wire_data_of(t)` — the flat data of an already-normalized wire
--- record (the bias / BN parameter vectors after `as_wire`). Module
--- arrows capture only *earlier* bindings, so this helper precedes its
--- use sites.
wire_data_of := (t) ~> t.__tensor__.data

--- `tensor.conv2d` — NCHW cross-correlation (no kernel flip):
--- `conv2d(input, weight, bias?, stride?, padding?, groups?)` with
--- `input [N, C_in, H, W]` and `weight [C_out, C_in/groups, kH, kW]`.
--- The output `[N, C_out, H_out, W_out]` is produced in row-major
--- order; each output pixel's accumulation loop is spelled exactly as
--- the Rust impl's (`acc` starts at the bias, out-of-range input
--- positions are the implicit zero padding).
export conv2d := (input, weight, ...rest) ~> do {
  wi :: as_wire(input)
  ww :: as_wire(weight)
  ish :: wi.__tensor__.shape
  wsh :: ww.__tensor__.shape
  check_rank :: if len(ish) == 4 && len(wsh) == 4 { true } else {
    die("tensor.conv2d: expected rank-4 input and weight (NCHW x OIHW)")
  }
  bias :: match opt_at(rest, 0) {
    null: null,
    b: wire_data_of(as_wire(b))
  }
  sp :: pair_or(opt_at(rest, 1), [1, 1])
  pp :: pair_or(opt_at(rest, 2), [0, 0])
  groups :: pos_int_or(opt_at(rest, 3), 1)
  s_h :: sp[0]
  s_w :: sp[1]
  p_h :: pp[0]
  p_w :: pp[1]
  check_stride :: if s_h > 0 && s_w > 0 { true } else {
    die("tensor.conv2d: stride must be positive")
  }
  n :: ish[0]
  c_in :: ish[1]
  h :: ish[2]
  w :: ish[3]
  c_out :: wsh[0]
  c_in_w :: wsh[1]
  k_h :: wsh[2]
  k_w :: wsh[3]
  check_groups :: if c_in % groups == 0 && c_out % groups == 0 { true } else {
    die("tensor.conv2d: groups must divide both C_in and C_out")
  }
  c_in_g :: c_in / groups
  c_out_g :: c_out / groups
  check_cin :: if c_in_w == c_in_g { true } else {
    die("tensor.conv2d: weight channels != C_in/groups")
  }
  check_bias :: if bias == null || len(bias) == c_out { true } else {
    die("tensor.conv2d: bias shape != [C_out]")
  }
  check_fit :: if h + 2 * p_h >= k_h && w + 2 * p_w >= k_w { true } else {
    die("tensor.conv2d: kernel exceeds the padded input")
  }
  h_out :: (h + 2 * p_h - k_h) / s_h + 1
  w_out :: (w + 2 * p_w - k_w) / s_w + 1
  di :: wi.__tensor__.data
  dw :: ww.__tensor__.data
  -- one output pixel: `acc` = bias (or 0) + Σ_ic,ky,kx in·wt, with
  -- input positions outside the padded bounds skipped (zero padding).
  px := (ix) ~> do {
    bn :: ix[0]
    co :: ix[1]
    oy :: ix[2]
    ox :: ix[3]
    g :: co / c_out_g
    acc0 :: if bias == null { 0 } else { bias[co] }
    while { ic: 0, ky: 0, kx: 0, acc: acc0 } {
      (ic, ky, kx, acc) ~> if ic < c_in_g {
        do {
          ci :: g * c_in_g + ic
          iy :: oy * s_h + ky
          in_y :: iy >= p_h && iy - p_h < h
          -- advance the kx/ky/ic odometer; `acc` gains this cell's
          -- contribution only when the input position is in range.
          step :: if kx + 1 < k_w {
            { ic: ic, ky: ky, kx: kx + 1 }
          } else {
            if ky + 1 < k_h {
              { ic: ic, ky: ky + 1, kx: 0 }
            } else { { ic: ic + 1, ky: 0, kx: 0 } }
          }
          if in_y {
            do {
              ix2 :: ox * s_w + kx
              in_x :: ix2 >= p_w && ix2 - p_w < w
              if in_x {
                { state: {
                  ic: step.ic, ky: step.ky, kx: step.kx,
                  acc: acc + di[((bn * c_in + ci) * h + iy - p_h) * w + ix2 - p_w] *
                             dw[((co * c_in_g + ic) * k_h + ky) * k_w + kx]
                } }
              } else { { state: { ic: step.ic, ky: step.ky, kx: step.kx, acc: acc } } }
            }
          } else { { state: { ic: step.ic, ky: step.ky, kx: step.kx, acc: acc } } }
        }
      } else { { out: acc } }
    }
  }
  osh :: [n, c_out, h_out, w_out]
  ds :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < product(osh) {
      { state: { i: i + 1, acc: [...acc, px(unravel(osh, i))] } }
    } else { { out: acc } }
  }
  wire(osh, ds)
}

--- `tensor.max_pool` — NCHW max pooling `max_pool(input, kernel,
--- stride?)`: `input [N, C, H, W]`, `kernel`/`stride` int-or-`[h, w]`
--- (stride defaults to the kernel); `out[n, c, oy, ox]` is the max of
--- the `kH x kW` window at `(oy·sH, ox·sW)`, trailing partial windows
--- dropped (floor mode). The window max starts at the first cell and
--- folds over the rest (the Rust impl's `f64::NEG_INFINITY` seed is
--- equivalent — the kernel always fits, so a first cell always exists).
export max_pool := (input, ...rest) ~> do {
  wi :: as_wire(input)
  ish :: wi.__tensor__.shape
  check_rank :: if len(ish) == 4 { true } else {
    die("tensor.max_pool: expected a rank-4 input [N, C, H, W]")
  }
  check_kernel :: if opt_at(rest, 0) == null { die("tensor.max_pool: kernel is required") } else { true }
  kp :: pair_or(opt_at(rest, 0), [0, 0])
  sp :: pair_or(opt_at(rest, 1), kp)
  k_h :: kp[0]
  k_w :: kp[1]
  s_h :: sp[0]
  s_w :: sp[1]
  check_pos :: if k_h > 0 && k_w > 0 { true } else {
    die("tensor.max_pool: kernel must be positive")
  }
  check_stride :: if s_h > 0 && s_w > 0 { true } else {
    die("tensor.max_pool: stride must be positive")
  }
  n :: ish[0]
  c :: ish[1]
  h :: ish[2]
  w :: ish[3]
  check_fit :: if k_h <= h && k_w <= w { true } else {
    die("tensor.max_pool: kernel exceeds input spatial dims")
  }
  h_out :: (h - k_h) / s_h + 1
  w_out :: (w - k_w) / s_w + 1
  hw :: h * w
  di :: wi.__tensor__.data
  px := (ix) ~> do {
    base :: (ix[0] * c + ix[1]) * hw
    y0 :: ix[2] * s_h
    x0 :: ix[3] * s_w
    -- fold the k_h*k_w window: cell (ky, kx) sits at
    -- base + (y0 + ky)*w + (x0 + kx)
    while { j: 0, acc: di[base + y0 * w + x0] } {
      (j, acc) ~> if j + 1 < k_h * k_w {
        do {
          j2 :: j + 1
          ky :: j2 / k_w
          kx :: j2 % k_w
          v :: di[base + (y0 + ky) * w + x0 + kx]
          { state: { j: j2, acc: if v > acc { v } else { acc } } }
        }
      } else { { out: acc } }
    }
  }
  osh :: [n, c, h_out, w_out]
  ds :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < product(osh) {
      { state: { i: i + 1, acc: [...acc, px(unravel(osh, i))] } }
    } else { { out: acc } }
  }
  wire(osh, ds)
}

--- `tensor.conv2d_backward` — the adjoint, mirroring the host's
--- `Conv2dBackward`: `conv2d_backward(input, weight, grad_out, bias?,
--- stride?, padding?, groups?)` scatters `grad_out` back through the
--- primal's index arithmetic — `dx` is the transposed convolution,
--- `dw` the input–gradient correlation, `db` the per-channel grad sum
--- (emitted only when `bias` was given). Same validation order and
--- loop nesting as `conv2d`.
export conv2d_backward := (input, weight, grad_out, ...rest) ~> do {
  wi :: as_wire(input)
  wt :: as_wire(weight)
  wg :: as_wire(grad_out)
  ish :: wi.__tensor__.shape
  wsh :: wt.__tensor__.shape
  gsh :: wg.__tensor__.shape
  check_rank :: if len(ish) == 4 && len(wsh) == 4 && len(gsh) == 4 { true } else {
    die("tensor.conv2d_backward: expected rank-4 input, weight, and grad_out")
  }
  bias :: match opt_at(rest, 0) {
    null: null,
    b: wire_data_of(as_wire(b))
  }
  sp :: pair_or(opt_at(rest, 1), [1, 1])
  pp :: pair_or(opt_at(rest, 2), [0, 0])
  groups :: pos_int_or(opt_at(rest, 3), 1)
  s_h :: sp[0]
  s_w :: sp[1]
  p_h :: pp[0]
  p_w :: pp[1]
  check_stride :: if s_h > 0 && s_w > 0 { true } else {
    die("tensor.conv2d_backward: stride must be positive")
  }
  n :: ish[0]
  c_in :: ish[1]
  h :: ish[2]
  w :: ish[3]
  c_out :: wsh[0]
  c_in_w :: wsh[1]
  k_h :: wsh[2]
  k_w :: wsh[3]
  check_groups :: if c_in % groups == 0 && c_out % groups == 0 { true } else {
    die("tensor.conv2d_backward: groups must divide both C_in and C_out")
  }
  c_in_g :: c_in / groups
  c_out_g :: c_out / groups
  check_cin :: if c_in_w == c_in_g { true } else {
    die("tensor.conv2d_backward: weight channels != C_in/groups")
  }
  check_bias :: if bias == null || len(bias) == c_out { true } else {
    die("tensor.conv2d_backward: bias shape != [C_out]")
  }
  check_fit :: if h + 2 * p_h >= k_h && w + 2 * p_w >= k_w { true } else {
    die("tensor.conv2d_backward: kernel exceeds the padded input")
  }
  h_out :: (h + 2 * p_h - k_h) / s_h + 1
  w_out :: (w + 2 * p_w - k_w) / s_w + 1
  check_grad :: if gsh == [n, c_out, h_out, w_out] { true } else {
    die("tensor.conv2d_backward: grad_out shape != conv2d output")
  }
  id :: wi.__tensor__.data
  wd :: wt.__tensor__.data
  gd :: wg.__tensor__.data
  -- For each output position (bn, co, oy, ox): gv = g[bn,co,oy,ox] is
  -- scattered into dx[iy,ix] += gv·w[co,ic,ky,kx] and accumulated into
  -- dw[co,ic,ky,kx] += gv·x[iy,ix] over the valid taps.
  r :: while { bn: 0, gg: 0, oc: 0, oy: 0, ox: 0,
               dx: replicate(0, len(id)), dw: replicate(0, len(wd)),
               db: replicate(0, c_out) } {
    (bn, gg, oc, oy, ox, dx, dw, db) ~> if bn < n {
      do {
        co :: gg * c_out_g + oc
        gv :: gd[((bn * c_out + co) * h_out + oy) * w_out + ox]
        dbn :: set(db, co, db[co] + gv)
        rr :: while { ic: 0, ky: 0, kx: 0, dxa: dx, dwa: dw } {
          (ic, ky, kx, dxa, dwa) ~> if ic < c_in_g {
            do {
              ci :: gg * c_in_g + ic
              iy0 :: oy * s_h + ky
              ix0 :: ox * s_w + kx
              upd :: if iy0 >= p_h && iy0 - p_h < h && ix0 >= p_w && ix0 - p_w < w {
                do {
                  iy :: iy0 - p_h
                  ix :: ix0 - p_w
                  ii :: ((bn * c_in + ci) * h + iy) * w + ix
                  wj :: ((co * c_in_g + ic) * k_h + ky) * k_w + kx
                  ({ dxa: set(dxa, ii, dxa[ii] + gv * wd[wj]),
                     dwa: set(dwa, wj, dwa[wj] + gv * id[ii]) })
                }
              } else { ({ dxa: dxa, dwa: dwa }) }
              nkx :: if kx + 1 < k_w { kx + 1 } else { 0 }
              nky :: if kx + 1 < k_w { ky } else { if ky + 1 < k_h { ky + 1 } else { 0 } }
              nic :: if kx + 1 < k_w || ky + 1 < k_h { ic } else { ic + 1 }
              { state: { ic: nic, ky: nky, kx: nkx, dxa: upd.dxa, dwa: upd.dwa } }
            }
          } else { { out: { dxa: dxa, dwa: dwa } } }
        }
        nox :: if ox + 1 < w_out { ox + 1 } else { 0 }
        noy :: if ox + 1 < w_out { oy } else { if oy + 1 < h_out { oy + 1 } else { 0 } }
        noc :: if ox + 1 < w_out || oy + 1 < h_out { oc } else { if oc + 1 < c_out_g { oc + 1 } else { 0 } }
        ngg :: if ox + 1 < w_out || oy + 1 < h_out || oc + 1 < c_out_g { gg } else { gg + 1 }
        nbn :: if ox + 1 < w_out || oy + 1 < h_out || oc + 1 < c_out_g || gg + 1 < groups { bn } else { bn + 1 }
        { state: { bn: nbn, gg: ngg, oc: noc, oy: noy, ox: nox,
                   dx: rr.dxa, dw: rr.dwa, db: dbn } }
      }
    } else { { out: { dx: dx, dw: dw, db: db } } }
  }
  if bias == null {
    ({ input: wire(ish, r.dx), weight: wire(wsh, r.dw) })
  } else {
    ({ input: wire(ish, r.dx), weight: wire(wsh, r.dw), bias: wire([c_out], r.db) })
  }
}
