-- aten: aten::tril(Tensor self, SymInt diagonal=0) -> Tensor
export tril := (t, ...rest) ~> aten_ow(aten_triu(t, aten_opt(rest, 0, 0), false))

-- aten: aten::diag(Tensor self, int diagonal=0) -> Tensor
export diag := (t, ...rest) ~> aten_ow(aten_diag(t, aten_opt(rest, 0, 0)))

-- aten: aten::diagonal(Tensor(a) self, int offset=0, int dim1=0, int dim2=1) -> Tensor(a)
export diagonal := (t, ...rest) ~> aten_ow(aten_diagonal(t, aten_opt(rest, 0, 0), aten_opt(rest, 1, 0), aten_opt(rest, 2, 1)))

-- aten: aten::trace(Tensor self) -> Tensor
export trace := (t, ...rest) ~> aten_ow(aten_trace(t))

