export rot90 := (t, ...rest) ~> aten_ow(aten_rot90(t, aten_opt(rest, 0, 1), aten_opt(rest, 1, null)))

-- aten: aten::contiguous(Tensor(a) self, *, MemoryFormat memory_format=0) -> Tensor(a)
export contiguous := (t, ...rest) ~> aten_ow(aten_id(t))

-- aten: aten::clone(Tensor self, *, MemoryFormat memory_format=None) -> Tensor
export clone := (t, ...rest) ~> aten_ow(aten_id(t))

-- aten: aten::detach(Tensor(a) self) -> Tensor(a)
export detach := (t, ...rest) ~> aten_ow(aten_id(t))

-- aten: aten::view(Tensor(a) self, SymInt[] size) -> Tensor(a)
export view := (t, ...rest) ~> aten_ow(aten_reshape_view(t, aten_req(rest, 0)))

-- aten: aten::pixel_shuffle(Tensor self, int upscale_factor) -> Tensor
export pixel_shuffle := (t, ...rest) ~> aten_ow(aten_pixel_space_depth(t, aten_req(rest, 0), true))

-- aten: aten::pixel_unshuffle(Tensor self, int downscale_factor) -> Tensor
export pixel_unshuffle := (t, ...rest) ~> aten_ow(aten_pixel_space_depth(t, aten_req(rest, 0), false))

-- aten: aten::constant_pad_nd(Tensor self, SymInt[] pad, Scalar value=0) -> Tensor
export constant_pad_nd := (t, ...rest) ~> aten_ow(aten_constant_pad_nd(t, aten_req(rest, 0), aten_opt(rest, 1, 0)))

-- aten: aten::_unique(Tensor self, bool sorted=True, bool return_inverse=False) -> (Tensor, Tensor)
export unique := (t, ...rest) ~> aten_unique(t, aten_opt(rest, 0, true), aten_opt(rest, 1, false))

-- aten: aten::nonzero_static(Tensor self, *, SymInt size, int fill_value=-1) -> Tensor
export nonzero_dim := (t, ...rest) ~> aten_ow(aten_nonzero_static(t, aten_req(rest, 0), aten_opt(rest, 1, -1)))

