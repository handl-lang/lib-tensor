--- aten-port-gen: index family ---
-- aten: aten::nonzero(Tensor self) -> Tensor
export nonzero := (t, ...rest) ~> aten_ow(aten_nonzero(t))

-- aten: aten::argwhere(Tensor self) -> Tensor
export argwhere := (t, ...rest) ~> aten_ow(aten_nonzero(t))

-- aten: aten::squeeze.dims(Tensor(a) self, int[] dim) -> Tensor(a)
export squeeze := (t, ...rest) ~> aten_ow(aten_squeeze(t, aten_opt(rest, 0, null)))

-- aten: aten::index_select(Tensor self, int dim, Tensor index) -> Tensor
export index_select := (t, ...rest) ~> aten_ow(aten_index_select(t, aten_req(rest, 0), aten_req(rest, 1)))

-- aten: aten::gather(Tensor self, int dim, Tensor index, *, bool sparse_grad=False) -> Tensor
export gather := (t, ...rest) ~> aten_ow(aten_gather(t, aten_req(rest, 0), aten_req(rest, 1)))

-- aten: aten::index_add(Tensor self, int dim, Tensor index, Tensor source, *, Scalar alpha=1) -> Tensor
export index_add := (t, ...rest) ~> aten_ow(aten_index_add(t, aten_req(rest, 0), aten_req(rest, 1), aten_req(rest, 2), aten_opt(rest, 3, 1)))

-- aten: aten::index_fill.int_Scalar(Tensor self, int dim, Tensor index, Scalar value) -> Tensor
export index_fill := (t, ...rest) ~> aten_ow(aten_index_fill(t, aten_req(rest, 0), aten_req(rest, 1), aten_req(rest, 2)))

-- aten: aten::take(Tensor self, Tensor index) -> Tensor
export take := (t, ...rest) ~> aten_ow(aten_take(t, aten_req(rest, 0)))

-- aten: aten::flatten.using_ints(Tensor(a) self, int start_dim=0, int end_dim=-1) -> Tensor(a)
export flatten := (t, ...rest) ~> aten_ow(aten_flatten(t, aten_opt(rest, 0, 0), aten_opt(rest, 1, -1)))

-- aten: aten::expand(Tensor(a) self, SymInt[] size, *, bool implicit=False) -> Tensor(a)
export expand := (t, ...rest) ~> aten_ow(aten_expand(t, aten_req(rest, 0)))

-- aten: aten::expand_as(Tensor(a) self, Tensor other) -> Tensor(a)
export expand_as := (t, ...rest) ~> aten_ow(aten_expand_as(t, aten_req(rest, 0)))

-- aten: aten::narrow(Tensor(a) self, int dim, SymInt start, SymInt length) -> Tensor(a)
export narrow := (t, ...rest) ~> aten_ow(aten_slice_dim(t, aten_req(rest, 0), aten_req(rest, 1), aten_req(rest, 2)))

-- aten: aten::slice.Tensor(Tensor(a) self, int dim=0, SymInt start=None, SymInt end=None, SymInt step=1) -> Tensor(a)
export slice := (t, ...rest) ~> aten_ow(aten_slice(t, aten_req(rest, 0), aten_opt(rest, 1, null), aten_opt(rest, 2, null), aten_opt(rest, 3, 1)))

-- aten: aten::chunk(Tensor(a -> *) self, int chunks, int dim=0) -> Tensor(a)[]
export chunk := (t, ...rest) ~> aten_owl(aten_chunk(t, aten_req(rest, 0), aten_opt(rest, 1, 0)))

-- aten: aten::split.Tensor(Tensor(a -> *) self, SymInt split_size, int dim=0) -> Tensor(a)[]
export split := (t, ...rest) ~> aten_owl(aten_split(t, aten_req(rest, 0), aten_opt(rest, 1, 0)))

-- aten: aten::stack(Tensor[] tensors, int dim=0) -> Tensor
export stack := (t, ...rest) ~> aten_ow(aten_stack(t, aten_opt(rest, 0, 0)))

-- aten: aten::unbind.int(Tensor(a -> *) self, int dim=0) -> Tensor(a)[]
export unbind := (t, ...rest) ~> aten_owl(aten_unbind(t, aten_req(rest, 0)))

-- aten: aten::repeat(Tensor self, SymInt[] repeats) -> Tensor
export repeat := (t, ...rest) ~> aten_ow(aten_repeat(t, aten_req(rest, 0)))

-- aten: aten::flip(Tensor self, int[] dims) -> Tensor
export flip := (t, ...rest) ~> aten_ow(aten_flip(t, aten_opt(rest, 0, null)))

-- aten: aten::triu(Tensor self, SymInt diagonal=0) -> Tensor
