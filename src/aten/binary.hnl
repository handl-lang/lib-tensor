from "math" import * as math
--- aten-port-gen: binary family ---
-- aten: aten::heaviside(Tensor self, Tensor values) -> Tensor
export heaviside := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x > 0 { 1 } else { if x < 0 { 0 } else { 0.5 * y } }))
}

-- aten: aten::atan2(Tensor self, Tensor other) -> Tensor
export atan2 := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> math.atan2(x, y)))
}

-- aten: aten::hypot(Tensor self, Tensor other) -> Tensor
export hypot := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> math.hypot(x, y)))
}

-- aten: aten::logaddexp(Tensor self, Tensor other) -> Tensor
export logaddexp := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> do {
  m :: aten_fmax(x, y)
  m + math.log(math.exp(x - m) + math.exp(y - m))
}))
}

-- aten: aten::maximum(Tensor self, Tensor other) -> Tensor
export maximum := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> aten_fmax(x, y)))
}

-- aten: aten::minimum(Tensor self, Tensor other) -> Tensor
export minimum := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> aten_fmin(x, y)))
}

-- aten: aten::fmod.Tensor(Tensor self, Tensor other) -> Tensor
export fmod := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> x % y))
}

-- aten: aten::floor_divide(Tensor self, Tensor other) -> Tensor
export floor_divide := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> aten_floor(x / y)))
}

-- aten: aten::remainder.Tensor(Tensor self, Tensor other) -> Tensor
export remainder := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> do {
  rr :: x % y
  if rr != 0 && (rr < 0) != (y < 0) { rr + y } else { rr }
}))
}

-- aten: aten::pow.Tensor_Tensor(Tensor self, Tensor exponent) -> Tensor
export pow := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> math.pow(x, y)))
}

-- aten: aten::float_power.Tensor_Tensor(Tensor self, Tensor exponent) -> Tensor
export float_power := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> math.pow(x, y)))
}

-- aten: aten::eq.Tensor(Tensor self, Tensor other) -> Tensor
export eq := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x == y { 1 } else { 0 }))
}

-- aten: aten::ne.Tensor(Tensor self, Tensor other) -> Tensor
export ne := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x != y { 1 } else { 0 }))
}

-- aten: aten::lt.Tensor(Tensor self, Tensor other) -> Tensor
export lt := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x < y { 1 } else { 0 }))
}

-- aten: aten::le.Tensor(Tensor self, Tensor other) -> Tensor
export le := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x <= y { 1 } else { 0 }))
}

-- aten: aten::gt.Tensor(Tensor self, Tensor other) -> Tensor
export gt := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x > y { 1 } else { 0 }))
}

-- aten: aten::ge.Tensor(Tensor self, Tensor other) -> Tensor
export ge := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x >= y { 1 } else { 0 }))
}

-- aten: aten::xlogy.Tensor(Tensor self, Tensor other) -> Tensor
export xlogy := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if x == 0 { 0 } else { x * math.log(y) }))
}

-- aten: aten::logical_and(Tensor self, Tensor other) -> Tensor
export logical_and := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if (x != 0) && (y != 0) { 1 } else { 0 }))
}

-- aten: aten::logical_or(Tensor self, Tensor other) -> Tensor
export logical_or := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if (x != 0) || (y != 0) { 1 } else { 0 }))
}

-- aten: aten::logical_xor(Tensor self, Tensor other) -> Tensor
export logical_xor := (a, b, ...rest) ~> do {
  aten_ow(aten_bin_ss(a, b, (x, y) ~> if (x != 0) != (y != 0) { 1 } else { 0 }))
}

