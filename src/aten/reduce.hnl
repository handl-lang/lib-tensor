--- aten-port-gen: reduce family ---
-- aten: aten::sum.dim_IntList(Tensor self, int[1] dim, bool keepdim=False, *, ScalarType dtype=None) -> Tensor
export sum := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_reduce(w, aten_dim_spec(aten_opt(rest, 0, null), len(w.__tensor__.shape)), aten_opt(rest, 1, false), 0, (a, b) ~> a + b))
}

-- aten: aten::prod.dim_int(Tensor self, int dim, bool keepdim=False, *, ScalarType dtype=None) -> Tensor
export prod := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_reduce(w, aten_dim_spec(aten_opt(rest, 0, null), len(w.__tensor__.shape)), aten_opt(rest, 1, false), 1, (a, b) ~> a * b))
}

-- aten: aten::mean.dim(Tensor self, int[1] dim, bool keepdim=False, *, ScalarType dtype=None) -> Tensor
export mean := (t, ...rest) ~> aten_ow(aten_mean(t, aten_opt(rest, 0, null), aten_opt(rest, 1, false)))

-- aten: aten::var.dim(Tensor self, int[1] dim, bool unbiased=True, bool keepdim=False) -> Tensor
export var := (t, ...rest) ~> aten_ow(aten_var_std(t, aten_opt(rest, 0, null), aten_opt(rest, 1, true), aten_opt(rest, 2, false), false))

-- aten: aten::std.dim(Tensor self, int[1] dim, bool unbiased=True, bool keepdim=False) -> Tensor
export std := (t, ...rest) ~> aten_ow(aten_var_std(t, aten_opt(rest, 0, null), aten_opt(rest, 1, true), aten_opt(rest, 2, false), true))

-- aten: aten::amax(Tensor self, int[1] dim=[], bool keepdim=False) -> Tensor
export amax := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_reduce(w, aten_dim_spec(aten_opt(rest, 0, null), len(w.__tensor__.shape)), aten_opt(rest, 1, false), 0 - aten_f64_max, (a, b) ~> aten_fmax(a, b)))
}

-- aten: aten::amin(Tensor self, int[1] dim=[], bool keepdim=False) -> Tensor
export amin := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_reduce(w, aten_dim_spec(aten_opt(rest, 0, null), len(w.__tensor__.shape)), aten_opt(rest, 1, false), aten_f64_max, (a, b) ~> aten_fmin(a, b)))
}

-- aten: aten::argmax(Tensor self, int dim=None, bool keepdim=False) -> Tensor
export argmax := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_arg_reduce(t, aten_opt(rest, 0, null), aten_opt(rest, 1, false), true))
}

-- aten: aten::argmin(Tensor self, int dim=None, bool keepdim=False) -> Tensor
export argmin := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_arg_reduce(t, aten_opt(rest, 0, null), aten_opt(rest, 1, false), false))
}

-- aten: aten::logsumexp(Tensor self, int[1] dim, bool keepdim=False) -> Tensor
export logsumexp := (t, ...rest) ~> aten_ow(aten_logsumexp(t, aten_req(rest, 0), aten_opt(rest, 1, false)))

-- aten: aten::all.dims(Tensor self, int[] dim=None, bool keepdim=False) -> Tensor
export all := (t, ...rest) ~> aten_ow(aten_allany(t, rest, true))

-- aten: aten::any.dims(Tensor self, int[] dim=None, bool keepdim=False) -> Tensor
export any := (t, ...rest) ~> aten_ow(aten_allany(t, rest, false))

-- aten: aten::cumsum(Tensor self, int dim, *, ScalarType dtype=None) -> Tensor
export cumsum := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_cum(t, aten_req(rest, 0), false))
}

-- aten: aten::cumprod(Tensor self, int dim, *, ScalarType dtype=None) -> Tensor
export cumprod := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_cum(t, aten_req(rest, 0), true))
}

-- aten: aten::softmax.int(Tensor self, int dim, ScalarType dtype=None) -> Tensor
export softmax := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_softmax(t, aten_req(rest, 0), false))
}

-- aten: aten::log_softmax.int(Tensor self, int dim, ScalarType dtype=None) -> Tensor
export log_softmax := (t, ...rest) ~> do {
  w :: as_wire(t)
  aten_ow(aten_softmax(t, aten_req(rest, 0), true))
}

-- aten: aten::max.other(Tensor self, Tensor other) -> Tensor
export max := (t, ...rest) ~> aten_maxmin(t, rest, true)

-- aten: aten::min.other(Tensor self, Tensor other) -> Tensor
export min := (t, ...rest) ~> aten_maxmin(t, rest, false)

-- aten: aten::count_nonzero(Tensor self, int dim=None) -> Tensor
export count_nonzero := (t, ...rest) ~> aten_ow(aten_count_nonzero(t, aten_opt(rest, 0, null)))

-- aten: aten::nansum(Tensor self, int[1] dim=None, bool keepdim=False, *, ScalarType dtype=None) -> Tensor
export nansum := (t, ...rest) ~> aten_ow(aten_nansum(t, aten_opt(rest, 0, null), aten_opt(rest, 1, false)))

-- aten: aten::nanmean(Tensor self, int[1] dim=None, bool keepdim=False, *, ScalarType dtype=None) -> Tensor
export nanmean := (t, ...rest) ~> aten_ow(aten_nanmean(t, aten_opt(rest, 0, null), aten_opt(rest, 1, false)))

