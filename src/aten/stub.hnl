-- aten: aten::exp2(Tensor self) -> Tensor
export exp2 := (t, ...rest) ~> do {
  die("aten.exp2: math.* has no exp2; math.pow(2,x) is not bit-identical")
}

-- aten: aten::expm1(Tensor self) -> Tensor
export expm1 := (t, ...rest) ~> do {
  die("aten.expm1: math.* has no expm1")
}

-- aten: aten::log1p(Tensor self) -> Tensor
export log1p := (t, ...rest) ~> do {
  die("aten.log1p: math.* has no log1p")
}

-- aten: aten::mish(Tensor self) -> Tensor
export mish := (t, ...rest) ~> do {
  die("aten.mish: needs ln_1p  same gap as aten::log1p")
}

-- aten: aten::softplus(Tensor self, Scalar beta=1, Scalar threshold=20) -> Tensor
export softplus := (t, ...rest) ~> do {
  die("aten.softplus: needs ln_1p  same gap as aten::log1p")
}

-- aten: aten::logaddexp2(Tensor self, Tensor other) -> Tensor
export logaddexp2 := (t, ...rest) ~> do {
  die("aten.logaddexp2: needs exp2  same gap as aten::exp2")
}

-- aten: aten::nextafter(Tensor self, Tensor other) -> Tensor
export nextafter := (t, ...rest) ~> do {
  die("aten.nextafter: one-ULP step needs f64 bit patterns the wire lacks")
}

-- aten: aten::copysign.Tensor(Tensor self, Tensor other) -> Tensor
export copysign := (t, ...rest) ~> do {
  die("aten.copysign: sign-of-zero semantics need bit-level access the wire lacks")
}

  -- SEAM (host-declared)
-- aten: aten::empty.memory_format(SymInt[] size, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None, MemoryFormat memory_format=None) -> Tensor
export empty := (t, ...rest) ~> do {
  die("aten.empty: uninitialized fill cannot be represented on the wire")
}

  -- SEAM (host-declared)
-- aten: aten::rand(SymInt[] size, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None) -> Tensor
export rand := (t, ...rest) ~> do {
  die("aten.rand: RNG state is not part of the wire contract; nondeterminism breaks verification")
}

  -- SEAM (host-declared)
-- aten: aten::normal.Tensor_float(Tensor mean, float std=1., *, Generator generator=None) -> Tensor
export normal := (t, ...rest) ~> do {
  die("aten.normal: RNG state is not part of the wire contract")
}

-- aten: aten::einsum(str equation, Tensor[] tensors, *, int[] path=None) -> Tensor
export einsum := (t, ...rest) ~> do {
  die("aten.einsum: equation-string arg + general contraction engine  handwritten seam (host has a dedicated parser)")
}

