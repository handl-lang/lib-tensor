--- aten-port-gen: nn family ---
-- aten: aten::layer_norm(Tensor input, SymInt[] normalized_shape, Tensor weight=None, Tensor bias=None, float eps=1.0000000000000001e-05, bool cudnn_enable=True) -> Tensor
export layer_norm := (t, ...rest) ~> aten_ow(aten_layer_norm(t, aten_req(rest, 0), aten_opt(rest, 1, null), aten_opt(rest, 2, null), aten_opt(rest, 3, 0.00001)))

-- aten: aten::rms_norm(Tensor input, SymInt[] normalized_shape, Tensor weight=None, float eps=None) -> Tensor
export rms_norm := (t, ...rest) ~> aten_ow(aten_rms_norm(t, aten_req(rest, 0), aten_opt(rest, 1, null), aten_opt(rest, 2, 0.00001)))

-- aten: aten::glu(Tensor self, int dim=-1) -> Tensor
export glu := (t, ...rest) ~> aten_ow(aten_glu(t, aten_opt(rest, 0, -1)))

-- aten: aten::avg_pool2d(Tensor self, int[2] kernel_size, int[2] stride=[], int[2] padding=0, bool ceil_mode=False, bool count_include_pad=True, int divisor_override=None) -> Tensor
export avg_pool2d := (t, ...rest) ~> aten_ow(aten_avg_pool2d(t, aten_req(rest, 0), aten_opt(rest, 1, null), aten_opt(rest, 2, 0), aten_opt(rest, 3, false), aten_opt(rest, 4, true), aten_opt(rest, 5, null)))

