--- aten-port-gen: sortsel family ---
-- aten: aten::sort(Tensor self, int dim=-1, bool descending=False) -> (Tensor values, Tensor indices)
export sort_ := (t, ...rest) ~> do {
  s :: aten_sort_dim(t, aten_opt(rest, 0, -1), aten_opt(rest, 1, false))
  ({ values: aten_W(s.v), indices: aten_W(s.i) })
}

-- aten: aten::argsort(Tensor self, int dim=-1, bool descending=False) -> Tensor
export argsort := (t, ...rest) ~> do {
  s :: aten_sort_dim(t, aten_opt(rest, 0, -1), aten_opt(rest, 1, false))
  aten_W(s.i)
}

-- aten: aten::topk(Tensor self, SymInt k, int dim=-1, bool largest=True, bool sorted=True) -> (Tensor values, Tensor indices)
export topk := (t, ...rest) ~> do {
  r :: aten_topk(t, aten_req(rest, 0), aten_opt(rest, 1, -1), aten_opt(rest, 2, true))
  ({ values: aten_W(r.v), indices: aten_W(r.i) })
}

-- aten: aten::median(Tensor self) -> Tensor
export median := (t, ...rest) ~> do {
  r :: aten_median(t, rest)
  if aten_is_num(r) || r.s != null { aten_ow(r) } else { r }
}

-- aten: aten::mode(Tensor self, int dim=-1, bool keepdim=False) -> (Tensor values, Tensor indices)
export mode := (t, ...rest) ~> aten_mode(t, aten_req(rest, 0), aten_opt(rest, 1, false))

-- aten: aten::kthvalue(Tensor self, SymInt k, int dim=-1, bool keepdim=False) -> (Tensor values, Tensor indices)
export kthvalue := (t, ...rest) ~> aten_kthvalue(t, aten_req(rest, 0), aten_opt(rest, 1, 0), aten_opt(rest, 2, false))

-- aten: aten::quantile(Tensor self, Tensor q, int dim=None, bool keepdim=False, *, str interpolation="linear") -> Tensor
export quantile := (t, ...rest) ~> aten_ow(aten_quantile(t, rest))

-- aten: aten::searchsorted.Tensor(Tensor sorted_sequence, Tensor self, *, bool out_int32=False, bool right=False, str side=None, Tensor sorter=None) -> Tensor
export searchsorted := (t, ...rest) ~> aten_ow(aten_searchsorted(t, aten_req(rest, 0), aten_opt(rest, 1, false)))

-- aten: aten::msort(Tensor self) -> Tensor
export msort := (t, ...rest) ~> aten_ow(aten_msort(t))

