--- aten-port-gen: construct family ---
-- aten: aten::full(SymInt[] size, Scalar fill_value, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None) -> Tensor
export full := (t, ...rest) ~> aten_ow(aten_full(t, aten_opt(rest, 0, 0)))

-- aten: aten::full_like(Tensor self, Scalar fill_value, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None, MemoryFormat memory_format=None) -> Tensor
export full_like := (t, ...rest) ~> aten_ow(aten_full_like(t, aten_opt(rest, 0, 0)))

-- aten: aten::zeros_like(Tensor self, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None, MemoryFormat memory_format=None) -> Tensor
export zeros_like := (t, ...rest) ~> aten_ow(aten_zeros_like(t))

-- aten: aten::ones_like(Tensor self, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None, MemoryFormat memory_format=None) -> Tensor
export ones_like := (t, ...rest) ~> aten_ow(aten_ones_like(t))

-- aten: aten::arange.start_step(Scalar start, Scalar end, Scalar step=1, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None) -> Tensor
export arange := (t, ...rest) ~> aten_ow(aten_arange([t, ...rest]))

-- aten: aten::linspace.Tensor_Tensor(Tensor start, Tensor end, int steps, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None) -> Tensor
export linspace := (t, ...rest) ~> aten_ow(aten_linspace(t, aten_req(rest, 0), aten_req(rest, 1), false, 0))

-- aten: aten::logspace.Tensor_Tensor(Tensor start, Tensor end, int steps, float base=10., *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None) -> Tensor
export logspace := (t, ...rest) ~> aten_ow(aten_linspace(t, aten_req(rest, 0), aten_req(rest, 1), true, aten_opt_num(rest, 2, 10)))

-- aten: aten::eye.m(SymInt n, SymInt m, *, ScalarType dtype=None, Layout layout=None, Device device=None, bool pin_memory=None) -> Tensor
export eye := (t, ...rest) ~> aten_ow(aten_eye(t, aten_opt(rest, 0, null)))

-- aten: aten::size.int(Tensor self, int dim) -> int
export size := (t, ...rest) ~> do {
  w :: as_wire(t)
  shp :: w.__tensor__.shape
  if len(rest) == 0 || rest[0] == null {
    shp
  } else {
    d :: rem_euclid(rest[0], len(shp))
    shp[d] * 1.0
  }
}

-- aten: aten::stride.int(Tensor self, int dim) -> int
export stride := (t, ...rest) ~> do {
  w :: as_wire(t)
  shp :: w.__tensor__.shape
  st :: strides(shp)
  if len(rest) == 0 || rest[0] == null {
    st
  } else {
    d :: rem_euclid(rest[0], len(shp))
    st[d] * 1.0
  }
}

-- aten: aten::numel(Tensor self) -> int
export numel := (t, ...rest) ~> do {
  w :: as_wire(t)
  len(w.__tensor__.data) * 1.0
}

-- aten: aten::dim(Tensor self) -> int
export dim := (t, ...rest) ~> do {
  w :: as_wire(t)
  len(w.__tensor__.shape) * 1.0
}

-- aten: aten::item(Tensor self) -> Scalar
export item := (t, ...rest) ~> do {
  w :: as_wire(t)
  d :: w.__tensor__.data
  if len(d) == 1 {
    d[0]
  } else {
    die("aten.item: numel != 1")
  }
}

-- aten: aten::is_contiguous(Tensor self) -> bool
export is_contiguous := (t, ...rest) ~> true

-- aten: aten::bincount(Tensor self, Tensor weights=None, SymInt minlength=0) -> Tensor
export bincount := (t, ...rest) ~> aten_ow(aten_bincount(t, aten_opt(rest, 0, null), aten_opt(rest, 1, 0)))

-- aten: aten::meshgrid(Tensor[] tensors) -> Tensor[]
export meshgrid := (t, ...rest) ~> aten_meshgrid([t, ...rest])

-- aten: aten::corrcoef(Tensor self) -> Tensor
export corrcoef := (t, ...rest) ~> aten_ow(aten_corrcoef(t))

-- aten: aten::to.dtype(Tensor(a) self, ScalarType dtype, bool non_blocking=False, bool copy=False, MemoryFormat memory_format=None) -> Tensor(a)
export to := (t, ...rest) ~> aten_ow(aten_to(t, aten_req(rest, 0)))

