--- aten-port-gen: unary family ---
-- aten: aten::abs(Tensor self) -> Tensor
export abs := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> aten_abs(x)))
}

-- aten: aten::neg(Tensor self) -> Tensor
export neg := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> 0 - x))
}

