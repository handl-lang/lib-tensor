  aten_ow(aten_map1(w, (x) ~> aten_trunc(x)))
}

-- aten: aten::frac(Tensor self) -> Tensor
export frac := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> aten_fract(x)))
}

-- aten: aten::sign(Tensor self) -> Tensor
export sign := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x > 0 { 1 } else { if x < 0 { 0 - 1 } else { x } }))
}

-- aten: aten::sigmoid(Tensor self) -> Tensor
export sigmoid := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> 1 / (1 + math.exp(0 - x))))
}

-- aten: aten::silu(Tensor self) -> Tensor
export silu := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> x / (1 + math.exp(0 - x))))
}

-- aten: aten::mish(Tensor self) -> Tensor
export mish := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> x * math.tanh(math.log1p(math.exp(x)))))
}

-- aten: aten::gelu(Tensor self, *, str approximate="none") -> Tensor
export gelu := (t, ...rest) ~> do {
  approx := aten_opt(rest, 0, null)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> do {
  is_tanh := approx == "tanh"
  x3 := x * x * x
  v := if is_tanh {
    0.5 * x * (1 + math.tanh(math.sqrt(1.5707963267948966 / 3.141592653589793) * (x + 0.044715 * x3)))
  } else {
    0.5 * x * (1 + aten_erf(x / math.sqrt(2)))
  }
  v
}))
}

-- aten: aten::relu(Tensor self) -> Tensor
export relu := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> aten_fmax(x, 0)))
}

-- aten: aten::selu(Tensor self) -> Tensor
export selu := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x > 0 { 1.0507009873554805 * x } else { 1.0507009873554805 * 1.6732632423543772 * (math.exp(x) - 1) }))
}

-- aten: aten::elu(Tensor self, Scalar alpha=1, Scalar scale=1, Scalar input_scale=1) -> Tensor
export elu := (t, ...rest) ~> do {
  a := aten_opt_num(rest, 0, 1)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x > 0 { x } else { a * (math.exp(x) - 1) }))
}

-- aten: aten::celu(Tensor self, Scalar alpha=1.) -> Tensor
export celu := (t, ...rest) ~> do {
  a := aten_opt_num(rest, 0, 1)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> aten_fmax(x, 0) + a * (math.exp(aten_fmin(x / a, 0)) - 1)))
}

-- aten: aten::leaky_relu(Tensor self, Scalar negative_slope=0.01) -> Tensor
export leaky_relu := (t, ...rest) ~> do {
  ns := aten_opt_num(rest, 0, 0.01)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x >= 0 { x } else { ns * x }))
}

-- aten: aten::softplus(Tensor self, Scalar beta=1, Scalar threshold=20) -> Tensor
export softplus := (t, ...rest) ~> do {
  beta := aten_opt_num(rest, 0, 1)
thr := aten_opt_num(rest, 1, 20)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if beta * x > thr { x } else { math.log1p(math.exp(beta * x)) / beta }))
}

-- aten: aten::softshrink(Tensor self, Scalar lambd=0.5) -> Tensor
export softshrink := (t, ...rest) ~> do {
  lam := aten_opt_num(rest, 0, 0.5)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x > lam { x - lam } else { if x < 0 - lam { x + lam } else { 0 } }))
}

-- aten: aten::hardshrink(Tensor self, Scalar lambd=0.5) -> Tensor
export hardshrink := (t, ...rest) ~> do {
  lam := aten_opt_num(rest, 0, 0.5)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if aten_abs(x) > lam { x } else { 0 }))
}

-- aten: aten::hardtanh(Tensor self, Scalar min_val=-1, Scalar max_val=1) -> Tensor
export hardtanh := (t, ...rest) ~> do {
  lo := aten_opt_num(rest, 0, 0 - 1)
hi := aten_opt_num(rest, 1, 1)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> aten_fmin(aten_fmax(x, lo), hi)))
}

-- aten: aten::threshold(Tensor self, Scalar threshold, Scalar value) -> Tensor
export threshold := (t, ...rest) ~> do {
  th := aten_opt_num(rest, 0, 0)
v := aten_opt_num(rest, 1, 0)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x > th { x } else { v }))
}

-- aten: aten::erf(Tensor self) -> Tensor
export erf := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> aten_erf(x)))
}

-- aten: aten::erfc(Tensor self) -> Tensor
export erfc := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> 1 - aten_erf(x)))
}

-- aten: aten::sinc(Tensor self) -> Tensor
export sinc := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> if x == 0 { 1 } else { math.sin(3.141592653589793 * x) / (3.141592653589793 * x) }))
}

-- aten: aten::deg2rad(Tensor self) -> Tensor
export deg2rad := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> x * 3.141592653589793 / 180))
}

-- aten: aten::rad2deg(Tensor self) -> Tensor
export rad2deg := (t, ...rest) ~> do {
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> x * 180 / 3.141592653589793))
}

-- aten: aten::logit(Tensor self, float eps=None) -> Tensor
export logit := (t, ...rest) ~> do {
  eps := aten_opt(rest, 0, null)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> do {
  xc := if eps == null { x } else { aten_fmin(aten_fmax(x, eps), 1 - eps) }
  math.log(xc / (1 - xc))
}))
}

-- aten: aten::nan_to_num(Tensor self, float nan=None, float posinf=None, float neginf=None) -> Tensor
export nan_to_num := (t, ...rest) ~> do {
  nanv := aten_opt_num(rest, 0, 0)
posv := aten_opt(rest, 1, null)
negv := aten_opt(rest, 2, null)
  w := as_wire(t)
  aten_ow(aten_map1(w, (x) ~> do {
  xv := if aten_is_nan(x) { nanv } else { if aten_is_infinite(x) { if x > 0 { if posv == null { x } else { posv } } else { if negv == null { x } else { negv } } } else { x } }
  xv
}))
}

