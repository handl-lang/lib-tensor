--- elementwise.hnl — `add`/`mul`/`sub`/`div` with numpy broadcasting.
---
--- The spec mirror of `broadcast_elementwise` in
--- host-tensor/src/ops/elementwise.rs: align trailing dims, a `1`-dim
--- stretches, a
--- missing leading dim counts as `1`; a dim pair that differs with
--- neither side `1` is an error (`die`). The output is produced in
--- row-major order — flat position `k` unravels to an index tuple,
--- and each side's stride map (a `0` stride where the side's dim was
--- `1` or missing) projects it back into that input's flat data.

from "./internal/helpers.hnl" import { die, len, product, replicate, set, slice, strides, unravel, dot }
from "./codec.hnl" import { wire, as_wire, wire_shape, wire_data }

--- The broadcast of two shapes: pad the shorter with leading `1`s, then
--- each pair must be equal or contain a `1`.
export broadcast_shape := (a, b) ~> do {
  r :: if len(a) >= len(b) { len(a) } else { len(b) }
  pa :: [...replicate(1, r - len(a)), ...a]
  pb :: [...replicate(1, r - len(b)), ...b]
  while { i: 0, acc: [] } {
    (i, acc) ~> if i < r {
      do {
        da :: pa[i]
        db :: pb[i]
        o :: if da == db { da } else {
          if da == 1 { db } else {
            if db == 1 { da } else { die("elementwise: shapes are not broadcast-compatible") }
          }
        }
        { state: { i: i + 1, acc: [...acc, o] } }
      }
    } else { { out: acc } }
  }
}

--- Per-axis strides mapping an output index tuple back into `shape`'s
--- flat data under broadcast `out_shape`: contiguous row-major strides,
--- except a dim of `1` (or a missing leading dim) contributes `0`, so
--- its single index is reused across the stretch.
export broadcast_strides := (shape, out_shape) ~> do {
  inner :: strides(shape)
  off :: len(out_shape) - len(shape)
  inner_bc :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < len(shape) {
      do {
        s :: if shape[i] == 1 { 0 } else { inner[i] }
        { state: { i: i + 1, acc: [...acc, s] } }
      }
    } else { { out: acc } }
  }
  [...replicate(0, off), ...inner_bc]
}

--- The driver behind `add`/`mul`/`sub`/`div`: elementwise `f` over the
--- broadcast of `a` and `b`, accepting the wire record or an opaque
--- tensor on either side.
export elementwise := (a, b, f) ~> do {
  wa :: as_wire(a)
  wb :: as_wire(b)
  ash :: wa.__tensor__.shape
  bsh :: wb.__tensor__.shape
  osh :: broadcast_shape(ash, bsh)
  sa :: broadcast_strides(ash, osh)
  sb :: broadcast_strides(bsh, osh)
  da :: wa.__tensor__.data
  db :: wb.__tensor__.data
  n :: product(osh)
  ds :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < n {
      do {
        ix :: unravel(osh, i)
        v :: f(da[dot(ix, sa)], db[dot(ix, sb)])
        { state: { i: i + 1, acc: [...acc, v] } }
      }
    } else { { out: acc } }
  }
  wire(osh, ds)
}

--- `tensor.add` — elementwise `a + b`, numpy-style broadcasting.
export add := (a, b) ~> elementwise(a, b, (x, y) ~> x + y)

--- `tensor.mul` — elementwise `a * b`, numpy-style broadcasting.
export mul := (a, b) ~> elementwise(a, b, (x, y) ~> x * y)

--- `tensor.sub` — elementwise `a - b`, numpy-style broadcasting.
export sub := (a, b) ~> elementwise(a, b, (x, y) ~> x - y)

--- `tensor.div` — elementwise `a / b`, numpy-style broadcasting. `x/0`
--- is `inf`/`NaN`, matching the scalar `/` (and therefore the host op —
--- the `serde_json` wire then carries `null`, which both sides reject
--- on re-decode identically).
export div := (a, b) ~> elementwise(a, b, (x, y) ~> x / y)

--- `bc_data(ds, sh, osh)` — materialize `ds` (flat, shape `sh`)
--- broadcast to `osh`: the odometer + 0-stride stretch, mirroring
--- `broadcast_to` in host-tensor's elementwise.rs.
export bc_data := (ds, sh, osh) ~> do {
  st :: broadcast_strides(sh, osh)
  n :: product(osh)
  while { i: 0, acc: [] } {
    (i, acc) ~> if i < n {
      { state: { i: i + 1, acc: [...acc, ds[dot(unravel(osh, i), st)]] } }
    } else { { out: acc } }
  }
}

--- `unbroadcast(gd, gsh, tsh)` — the adjoint of broadcasting: sum the
--- flat grad `gd` (shape `gsh`) down to `tsh`, summing out leading dims
--- `tsh` lacks and any dim where `tsh` is `1` but `gsh` is larger
--- (mirrors `unbroadcast` in host-tensor's elementwise.rs).
export unbroadcast := (gd, gsh, tsh) ~> do {
  check :: if len(tsh) <= len(gsh) { true } else {
    die("unbroadcast: target rank exceeds grad rank")
  }
  off :: len(gsh) - len(tsh)
  tst :: strides(tsh)
  -- masked strides: a `1` dim sums out (contributes stride 0).
  mst :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < len(tsh) {
      do {
        s :: if tsh[i] == 1 { 0 } else { tst[i] }
        { state: { i: i + 1, acc: [...acc, s] } }
      }
    } else { { out: acc } }
  }
  n :: product(gsh)
  while { i: 0, acc: replicate(0, product(tsh)) } {
    (i, acc) ~> if i < n {
      do {
        ti :: dot(slice(unravel(gsh, i), off, len(tsh)), mst)
        { state: { i: i + 1, acc: set(acc, ti, acc[ti] + gd[i]) } }
      }
    } else { { out: acc } }
  }
}

--- The driver behind the elementwise adjoints: `g` must be the primal
--- output's shape (the broadcast of `a` and `b`); each operand's grad
--- is its per-element expression over the broadcast space — `fa`/`fb`
--- take `(a_elem, b_elem, g_elem)` — then `unbroadcast` back to the
--- operand's shape. Returns `{a, b}` (the host's `elementwise_backward`).
elt_bwd := (a, b, g, fa, fb) ~> do {
  wa :: as_wire(a)
  wb :: as_wire(b)
  wg :: as_wire(g)
  ash :: wa.__tensor__.shape
  bsh :: wb.__tensor__.shape
  gsh :: wg.__tensor__.shape
  osh :: broadcast_shape(ash, bsh)
  check :: if gsh == osh { true } else {
    die("elementwise backward: grad_out shape != broadcast output")
  }
  ad :: bc_data(wa.__tensor__.data, ash, osh)
  bd :: bc_data(wb.__tensor__.data, bsh, osh)
  gd :: wg.__tensor__.data
  n :: product(osh)
  ga :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < n {
      { state: { i: i + 1, acc: [...acc, fa(ad[i], bd[i], gd[i])] } }
    } else { { out: acc } }
  }
  gb :: while { i: 0, acc: [] } {
    (i, acc) ~> if i < n {
      { state: { i: i + 1, acc: [...acc, fb(ad[i], bd[i], gd[i])] } }
    } else { { out: acc } }
  }
  ({ a: wire(ash, unbroadcast(ga, osh, ash)), b: wire(bsh, unbroadcast(gb, osh, bsh)) })
}

--- `tensor.add_backward` — `da = g`, `db = g`, each unbroadcast.
export add_backward := (a, b, g) ~> elt_bwd(a, b, g, (x, y, gv) ~> gv, (x, y, gv) ~> gv)

--- `tensor.mul_backward` — `da = g·b`, `db = g·a`, unbroadcast.
export mul_backward := (a, b, g) ~> elt_bwd(a, b, g, (x, y, gv) ~> gv * y, (x, y, gv) ~> gv * x)

--- `tensor.sub_backward` — `da = g`, `db = −g`, unbroadcast.
export sub_backward := (a, b, g) ~> elt_bwd(a, b, g, (x, y, gv) ~> gv, (x, y, gv) ~> 0 - gv)

--- `tensor.div_backward` — `da = g/b`, `db = −g·a/b²`, unbroadcast.
export div_backward := (a, b, g) ~> elt_bwd(a, b, g, (x, y, gv) ~> gv / y, (x, y, gv) ~> 0 - (gv * x) / (y * y))
